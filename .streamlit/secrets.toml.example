# Copy to .streamlit/secrets.toml for local runs (never commit the real file).
# On Streamlit Cloud, paste these lines into the app's Settings → Secrets instead.
# Set one provider; Groq is used when its key is present.
GROQ_API_KEY = "your_groq_api_key"
# GROQ_MODEL = "openai/gpt-oss-120b"

# GEMINI_API_KEY = "your_gemini_api_key"
# GEMINI_MODEL = "gemini-2.5-flash"
